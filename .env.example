# Copy to .env and fill in real values for local dev.
# Matches docker-compose.yml's MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE.
DATABASE_URL="mysql://hn_crawler:hn_crawler_password@localhost:3306/hn_crawler"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"

# Only needed for self-hosted production deployments behind a proxy/non-standard host.
# AUTH_TRUST_HOST=true
